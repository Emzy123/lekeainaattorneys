// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  blogPosts BlogPost[]
  purchases Purchase[]

  @@map("users")
}

model Firm {
  id            String   @id @default(cuid())
  name          String
  tagline       String?
  logo          String?
  primaryColor  String   @default("#1a1a1a")
  secondaryColor String  @default("#ffffff")
  accentColor   String   @default("#3b82f6")
  fontPrimary   String   @default("Inter")
  fontSecondary String   @default("Inter")
  address       String
  phone         String
  email         String
  website       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("firms")
}

model PracticeArea {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  slug        String   @unique
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("practice_areas")
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  title     String
  bio       String
  photo     String?
  email     String?
  linkedin  String?
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  blogPosts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  excerpt      String
  content      String
  coverImage   String?
  published    Boolean   @default(false)
  publishedAt  DateTime?
  authorId     String
  categoryId   String?
  tags         String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  author   User          @relation(fields: [authorId], references: [id])
  category BlogCategory? @relation(fields: [categoryId], references: [id])

  @@map("blog_posts")
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String
  fileUrl     String
  fileSize    Int
  fileType    String
  price       Float
  currency    String   @default("USD")
  slug        String   @unique
  coverImage  String?
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  purchases Purchase[]

  @@map("resources")
}

model Purchase {
  id                String         @id @default(cuid())
  reference         String         @unique @default(cuid()) // Internal reference for verify page
  resourceId        String
  userId            String?        // Nullable for guest checkout
  buyerEmail        String         // Always captured for delivery
  amount            Int            // Amount in kobo (smallest currency unit)
  currency          String         @default("NGN")
  status            PurchaseStatus @default(PENDING)
  paystackReference String?        @unique // Raw Paystack transaction reference
  downloadUrl       String?
  downloadExpiresAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  resource Resource @relation(fields: [resourceId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@map("purchases")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String?
  content   String
  rating    Int
  photo     String?
  published Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model Page {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  content        String
  metaTitle      String?
  metaDescription String?
  published      Boolean      @default(false)
  template       PageTemplate @default(DEFAULT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("pages")
}

model ContactSubmission {
  id        String         @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus  @default(NEW)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("contact_submissions")
}

model ConsultationRequest {
  id           String                @id @default(cuid())
  name         String
  email        String
  phone        String
  caseType     String
  jurisdiction String
  brief        String                @db.Text
  preferredDate String?
  preferredTime String?
  status       ConsultationStatus    @default(NEW)
  assignedTo   String?               // attorney name or ID
  notes        String?               @db.Text
  reference    String                @unique @default(cuid())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@map("consultation_requests")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PageTemplate {
  DEFAULT
  ABOUT
  CONTACT
  PRIVACY
  TERMS
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ConsultationStatus {
  NEW
  REVIEWING
  SCHEDULED
  COMPLETED
  DECLINED
}
