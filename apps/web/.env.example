# ─── Database ────────────────────────────────────────────────────────────────
# For local dev using docker-compose (maps postgres to port 5433)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/lex_platform?schema=public"

# ─── App Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Paystack Payment Gateway ─────────────────────────────────────────────────
# Get your test keys at: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Public key used if you integrate Paystack Inline JS popup (optional)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Resend Email Delivery ────────────────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
